# Build from the repository root:
# docker build -f deploy/kubernetes-learning/images/Dockerfile.frontend -t klipcut-frontend:dev .
FROM node:22-alpine AS build

WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# API_BASE defaults to /api, matching the same-host Ingress.
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY deploy/kubernetes-learning/images/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/ /usr/share/nginx/html/

EXPOSE 8080

