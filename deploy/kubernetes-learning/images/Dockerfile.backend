# Build from the repository root:
# docker build -f deploy/kubernetes-learning/images/Dockerfile.backend -t klipcut-backend:dev .
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# YouTube now makes yt-dlp execute JavaScript (the "nsig"/signature challenge) to
# unlock the real media URLs. Without a JS runtime yt-dlp cannot solve it and
# YouTube answers "confirm you're not a bot" -- even through a residential proxy.
# Deno is yt-dlp's default runtime; copy the single static binary from the
# official image. DENO_DIR points at /tmp because the app runs as a home-less
# non-root user and Deno needs a writable cache dir.
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno
# Deno and yt-dlp both need a writable cache, but the app runs as a home-less
# non-root user -- point both at /tmp.
ENV DENO_DIR=/tmp/deno \
    XDG_CACHE_HOME=/tmp

WORKDIR /app

# Dependency layer changes less often than application code.
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# YouTube's extractor changes constantly and the fix always ships as a new yt-dlp
# release, so force the latest on every build rather than trusting the cached
# requirements layer (a stale yt-dlp is itself a common "bot" failure).
RUN pip install --no-cache-dir -U yt-dlp

# NOTE: the EJS challenge solver (--remote-components ejs:github) is applied only
# to the DOWNLOAD commands in app/pipeline/downloader.py, not globally. Enabling
# it globally made the *preview* call fetch from GitHub and hang, tying up the
# API. Downloads run in the isolated workers (with a stall watchdog), so scoping
# it there fixes throttling without risking the API.

COPY backend/ /app/

# The Kubernetes pod mounts writable emptyDir volumes on /app/storage and /tmp.
# Keeping the image process non-root limits the effect of an application escape.
RUN groupadd --gid 10001 clipper \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin clipper \
    && mkdir -p /app/storage \
    && chown -R 10001:10001 /app

USER 10001:10001
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

