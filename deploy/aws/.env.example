# Copy to deploy/aws/.env and fill in. Both the API and the workers read this
# same file (docker-compose passes it to both), so every key must be present.
# DATABASE_URL is set by docker-compose, not here.

# --- Postgres (the queue) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Where Polar sends the buyer back, and the origin browsers hit ---
CLIPPER_APP_ORIGIN=https://klipcut.yourdomain.com

# --- Auth ---
CLIPPER_SECRET_KEY=generate-with-openssl-rand-hex-32
ADMIN_EMAILS=vinaycjoshi310@gmail.com

# --- AI / transcription ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CLIPPER_MODEL_STANDARD=
CLIPPER_MODEL_ADVANCED=
YOUTUBE_API_KEY=

# --- Cloudflare R2 (STORAGE_BACKEND=r2 makes the API/worker split work) ---
STORAGE_BACKEND=r2
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cloudflare Turnstile (leave blank to disable the challenge) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Dodo Payments billing ---
# API key + webhook signing key from the Dodo dashboard (Developer > API Keys /
# Webhooks). Use test_mode while testing, live_mode in production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
# The ONE one-time "Pay What You Want" product every credit top-up checks out
# through (its price is passed per-checkout). Create it in Dodo and paste its id.
DODO_TOPUP_PRODUCT_ID=
# Subscription (Creator/Pro) product IDs are pasted into app/dodo_catalog.py,
# not here -- they are public identifiers, one fixed-price product per tier.

# --- Retention / worker tuning (optional) ---
CLIPPER_RETENTION_HOURS=72
CLIPPER_MAX_CONCURRENT_RENDERS=1
